@model GiaoNhanAssetPage
<div class="table-responsive">
<table class="table table-sm table-hover align-middle">
    <thead><tr><th>Tài sản / serial</th><th>Danh mục / vị trí</th><th>Điều kiện cấp phát</th><th>Chọn</th></tr></thead>
    <tbody>
    @if (Model.Items.Count == 0) { <tr><td colspan="4">Không tìm thấy tài sản phù hợp.</td></tr> }
    @foreach (var asset in Model.Items)
    {
        <tr><td><strong>@asset.Code</strong><br />@asset.Name<br /><small class="text-muted">@asset.Serial</small></td>
            <td>@asset.Category<br /><small>@asset.Location</small></td>
            <td>@if (asset.UnavailableReason == null) { <span class="badge bg-success">Sẵn sàng</span> } else { <span class="text-danger">@asset.UnavailableReason</span> }</td>
            <td><button type="button" class="btn btn-sm btn-outline-primary asset-add" data-id="@asset.Id" data-code="@asset.Code" data-name="@asset.Name" disabled="@(asset.UnavailableReason != null)">Chọn</button></td></tr>
    }
    </tbody>
</table>
</div>
<div class="d-flex justify-content-between align-items-center">
    <small>Trang @Model.Page / @Model.TotalPages · @Model.Total tài sản</small>
    <div class="btn-group">
        @if (Model.Page > 1) { <button type="button" class="btn btn-sm btn-outline-secondary asset-page" data-url="@Url.Action("AssetChoices", new { keyword = Model.Keyword, page = Model.Page - 1 })">Trước</button> }
        @if (Model.Page < Model.TotalPages) { <button type="button" class="btn btn-sm btn-outline-secondary asset-page" data-url="@Url.Action("AssetChoices", new { keyword = Model.Keyword, page = Model.Page + 1 })">Sau</button> }
    </div>
</div>

