@model CapPhatPage
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    Dictionary<string, string> Routes(int page)
    {
        if (Model is CapPhatIndex index) return index.Routes(page);
        if (Model is GiaoNhanRows rows) return rows.Routes(page);
        return new() { ["id"] = ViewContext.RouteData.Values["id"]?.ToString() ?? "", ["page"] = page.ToString() };
    }
}
<nav aria-label="Phân trang cấp phát" class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span>Trang @Model.Page / @Model.TotalPages · Hiển thị @Model.FirstItem–@Model.LastItem trong @Model.Total bản ghi</span>
    <div class="btn-group">
        @if (Model.Page > 1)
        {
            <a class="btn btn-outline-primary" asp-action="@currentAction" asp-all-route-data="Routes(Model.Page - 1)">Trang trước</a>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a class="btn btn-outline-primary" asp-action="@currentAction" asp-all-route-data="Routes(Model.Page + 1)">Trang sau</a>
        }
    </div>
</nav>
