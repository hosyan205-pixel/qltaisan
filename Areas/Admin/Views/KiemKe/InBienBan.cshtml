@model KiemKeChiTiet
@{ Layout=null; var doc=Model.Phieu; }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8" /><title>Biên bản kiểm kê @doc.KK_MaPhieu</title><style>
body{font:14px Arial,sans-serif;color:#111;margin:24px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #999;padding:6px;vertical-align:top}h1{text-align:center;font-size:23px}small{font-size:12px}.signatures{display:flex;justify-content:space-around;margin-top:36px;text-align:center;min-height:130px}pre{white-space:pre-wrap}@@media print{.no-print{display:none}thead{display:table-header-group}tr{break-inside:avoid}@@page{size:A4 landscape;margin:12mm}}
</style></head><body><div class="no-print"><button onclick="window.print()">In biên bản</button> <a asp-action="Details" asp-route-id="@doc.KK_ID">Quay lại</a></div>
<h1>BIÊN BẢN KIỂM KÊ TÀI SẢN</h1><p><strong>@doc.KK_MaPhieu — @doc.KK_TenDot</strong><br />@KiemKeUi.Label(doc.KK_LoaiPhamVi) · @doc.PhongBan?.PB_TenPhongBan · Ngày dự kiến @doc.KK_NgayKiemKe?.ToString("dd/MM/yyyy")<br />Trạng thái: @KiemKeUi.Label(doc.KK_TrangThai) · Người trực tiếp kiểm kê: @doc.NguoiKiemKe?.TK_HoTen</p>
@if(doc.KK_LaDuLieuCu){<p><strong>PHIẾU LỊCH SỬ — KHÔNG CÓ SNAPSHOT THỜI ĐIỂM KIỂM KÊ.</strong> Tên/mã tham chiếu hiện tại không thay thế sổ tại thời điểm cũ. Kết quả lịch sử được giữ nguyên.</p>}
else{<p>Chốt sổ: @doc.KK_ThoiDiemChotUTC?.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss") (giờ Việt Nam). Trong sổ: @Model.TongHop.DuKien; tìm thấy: @Model.TongHop.DaTimThay; không tìm thấy: @Model.TongHop.KhongTimThay; chưa kiểm: @Model.TongHop.ChuaKiem; thừa: @Model.TongHop.Thua; ngoài phạm vi: @Model.TongHop.NgoaiPhamVi; chênh lệch: @Model.TongHop.DongChenhLech dòng; @Model.TongHop.TongCo cờ sai lệch (có thể cùng một tài sản). Tiến độ: @Model.TongHop.TienDo.</p>}
<table><thead><tr><th>Tài sản</th><th>Sổ lúc chốt</th><th>Thực tế</th><th>Kết quả</th><th>Nguyên nhân / đề xuất / đối soát</th></tr></thead><tbody>
@foreach(var row in Model.Items){var line=row.Dong;<tr><td>@(line.CTKK_MaTaiSanSnapshot??line.CTKK_MaPhatHien??line.TaiSan?.TS_MaTaiSan)<br />@(line.CTKK_TenTaiSanSnapshot??line.CTKK_TenThucTe??line.TaiSan?.TS_TenTaiSan)<br />@KiemKeUi.Label(line.CTKK_LoaiDong)</td><td>@line.CTKK_SerialDuKien<br />@line.CTKK_DanhMucSnapshot · @line.CTKK_NguyenGiaDuKien?.ToString("N0")<br />@line.CTKK_PhongBanDuKienSnapshot<br />@line.CTKK_NguoiNhanDuKienSnapshot<br />@line.CTKK_ViTriDuKien<br />@line.CTKK_TinhTrangDuKien / @line.CTKK_TrangThaiDuKien</td><td>@(doc.KK_LaDuLieuCu?"":line.CTKK_DaTimThay==null?"Chưa kiểm":line.CTKK_DaTimThay==true?"Tìm thấy":"Không tìm thấy")<br />@line.CTKK_MaNhanDienThucTe / @line.CTKK_SerialThucTe<br />@line.PhongBanThucTe?.PB_TenPhongBan<br />@line.CTKK_NguoiSuDungThucTe<br />@line.CTKK_ViTriThucTe<br />@line.CTKK_TinhTrangThucTe</td><td>@KiemKeUi.Label(line.CTKK_KetQua)<br />@(line.CTKK_CoSaiPhongBan?"Sai PB; ":"") @(line.CTKK_CoSaiViTri?"Sai vị trí; ":"") @(line.CTKK_CoSaiNguoiSuDung?"Sai người giữ; ":"") @(line.CTKK_CoHuHong?"Hỏng; ":"") @(line.CTKK_ThieuPhuKien?"Thiếu phụ kiện":"")</td><td>@line.CTKK_LyDoChenhLech<br />@KiemKeUi.Label(line.CTKK_HuongXuLy)<br />@line.CTKK_DeXuatXuLy<br />@KiemKeUi.Label(line.CTKK_TrangThaiDoiSoat) · @line.NguoiDoiSoat?.TK_HoTen<br />Bằng chứng: @line.CTKK_BangChung<br />Ghi chú: @line.CTKK_GhiChu</td></tr>}
</tbody></table>
@if(doc.KK_TrangThai=="HoanThanh"){<p>Đã duyệt trên hệ thống bởi @doc.NguoiDuyet?.TK_HoTen lúc @doc.KK_NgayDuyetUTC?.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss") (giờ Việt Nam). Kết luận: @doc.KK_KetLuan</p>}else{<p><strong>Biên bản chưa phê duyệt / đã hủy theo trạng thái ghi trên. Không dùng làm bằng chứng phê duyệt.</strong></p>}
<div class="signatures"><div>Người kiểm kê<br /><small>(Ký, ghi rõ họ tên)</small></div><div>Đại diện đơn vị<br /><small>(Ký, ghi rõ họ tên)</small></div><div>Người phê duyệt<br /><small>(Ký, ghi rõ họ tên)</small></div></div>
</body></html>
