@model KiemKeGhiNhanInput
<input asp-for="RequestKey" type="hidden" /><input asp-for="PhienBan" type="hidden" />
@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="alert alert-danger"></div>}
<div class="row g-3">
    <div class="col-12"><label asp-for="CachGhiNhan" class="form-label">Kết quả kiểm tra thực tế</label><select asp-for="CachGhiNhan" class="form-select" required><option value="CoMat">Tìm thấy — ghi tình trạng để hệ thống đối chiếu khớp / chênh lệch</option><option value="KhongThay">Không tìm thấy sau khi kiểm tra thực tế</option><option value="CanXacMinh">Cần xác minh, chưa đủ căn cứ</option></select><small>Các giá trị gợi ý theo sổ cần được kiểm tra tại hiện vật trước khi ghi nhận.</small></div>
    <div class="col-md-6"><label asp-for="TinhTrang" class="form-label">Tình trạng thực tế</label><select asp-for="TinhTrang" class="form-select"><option value="">Chọn tình trạng</option>@foreach(var state in KiemKeUi.Conditions){<option value="@state">@KiemKeUi.Label(state)</option>}</select></div>
    <div class="col-md-6"><label asp-for="ViTri" class="form-label">Vị trí thực tế</label><input asp-for="ViTri" maxlength="255" class="form-control" /><label class="mt-1"><input asp-for="KhongApDungViTri" class="form-check-input" /> Vị trí không áp dụng (phải giải trình)</label></div>
    <div class="col-md-6"><label asp-for="PhongBanId" class="form-label">Phòng ban thực tế</label><select asp-for="PhongBanId" asp-items="@(ViewData["PhongBans"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)" class="form-select"><option value="">Chưa xác định / kho chung</option></select></div>
    <div class="col-md-6"><label asp-for="NguoiSuDungId" class="form-label">Tài khoản người sử dụng thực tế</label><select asp-for="NguoiSuDungId" asp-items="@(ViewData["NguoiDungs"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)" class="form-select"><option value="">Chưa xác định tài khoản</option></select></div>
    <div class="col-md-6"><label asp-for="NguoiSuDung" class="form-label">Tên thực tế khi chưa có tài khoản (cần căn cứ)</label><input asp-for="NguoiSuDung" maxlength="255" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="TenTaiSanThucTe" class="form-label">Tên hiện vật quan sát</label><input asp-for="TenTaiSanThucTe" maxlength="150" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="MaNhanDien" class="form-label">Mã quan sát thực tế</label><input asp-for="MaNhanDien" maxlength="100" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Serial" class="form-label">Serial thực tế</label><input asp-for="Serial" maxlength="100" class="form-control" /></div>
    <div class="col-12 d-flex flex-wrap gap-3"><label><input asp-for="CoHuHong" class="form-check-input" /> Có hư hỏng</label><label><input asp-for="ThieuPhuKien" class="form-check-input" /> Thiếu phụ kiện</label><label><input asp-for="KhacNguoiSuDung" class="form-check-input" /> Có bằng chứng khác người sử dụng</label></div>
    <div class="col-12"><label asp-for="GhiChu" class="form-label">Mô tả, giải trình và cách kiểm tra</label><textarea asp-for="GhiChu" maxlength="4000" rows="3" class="form-control"></textarea><small>Bắt buộc khi không tìm thấy, cần xác minh, hỏng, thiếu phụ kiện hoặc khai khác người sử dụng.</small></div>
    <div class="col-12"><label asp-for="BangChung" class="form-label">Bằng chứng / mã biên bản / xác nhận của nơi đang giữ</label><textarea asp-for="BangChung" maxlength="6000" rows="3" class="form-control"></textarea><label class="mt-2"><input asp-for="XacNhanCanCu" class="form-check-input" /> Tôi đã kiểm tra căn cứ về người giữ, bảo trì hoặc biến động sổ liên quan.</label></div>
    <div class="col-12"><label asp-for="LyDo" class="form-label">Lý do thay đổi kết quả đã đối soát (nếu có)</label><textarea asp-for="LyDo" maxlength="4000" rows="2" class="form-control"></textarea></div>
    <div class="col-12"><label><input asp-for="DaKiemTraThucTe" class="form-check-input" /> Tôi đã kiểm tra thực tế hiện vật và thông tin vừa khai.</label></div>
</div>
