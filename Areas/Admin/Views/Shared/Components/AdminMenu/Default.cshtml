@using DoAn.Areas.Admin.Models
@model IList<AdminMenu>
@{
    // Tên controller cũ trong database vẫn dẫn tới module giao/thu hồi hiện tại.
    string MenuController(string? name) => string.Equals(name, "BanGiao", StringComparison.OrdinalIgnoreCase) ? "CapPhat" : name ?? "";
    string MenuArea(AdminMenu item) => string.IsNullOrWhiteSpace(item.AreaName) ? "Admin" : item.AreaName;
    bool IsCurrent(AdminMenu item) =>
        string.Equals(MenuController(item.ControllerName), ViewContext.RouteData.Values["controller"]?.ToString(), StringComparison.OrdinalIgnoreCase) &&
        string.Equals(MenuArea(item), ViewContext.RouteData.Values["area"]?.ToString(), StringComparison.OrdinalIgnoreCase);
}

@if(Context.Items["KiemKeRestricted"] is true)
{
    <aside id="sidebar" class="sidebar"><ul class="sidebar-nav" id="sidebar-nav">
        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-grid"></i><span>Cổng nhân viên</span></a></li>
        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="KiemKe" asp-action="Index"><i class="bi bi-clipboard-check"></i><span>Kiểm kê tài sản</span></a></li>
    </ul></aside>
}
else if(Context.Items["GiaoNhanCanManage"] is false)
{
    <aside id="sidebar" class="sidebar"><ul class="sidebar-nav" id="sidebar-nav">
        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-grid"></i><span>Trang chủ</span></a></li>
        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="CapPhat" asp-action="Index"><i class="bi bi-file-text"></i><span>Phiếu liên quan đến tôi</span></a></li>
        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="CapPhat" asp-action="ActiveAssignments"><i class="bi bi-box"></i><span>Tài sản đang giữ</span></a></li>
        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="KiemKe" asp-action="Index"><i class="bi bi-clipboard-check"></i><span>Đợt kiểm kê được giao</span></a></li>
    </ul></aside>
}
else
{
<aside id="sidebar" class="sidebar">
    <ul class="sidebar-nav" id="sidebar-nav">

        @foreach (var item in Model.Where(m => m.ParentLevel == 0 && m.IsActive == true).OrderBy(m => m.ItemOrder).ThenBy(m => m.AdminMenuID))
        {
            var sMenu = Model.Where(m => m.ParentLevel == item.AdminMenuID && m.IsActive == true)
                .OrderBy(m => m.ItemOrder).ThenBy(m => m.AdminMenuID).ToList();
            var active = IsCurrent(item) || sMenu.Any(IsCurrent);
            var collapseId = !string.IsNullOrWhiteSpace(item.IdName) ? item.IdName
                : !string.IsNullOrWhiteSpace(item.ItemTarget) ? item.ItemTarget : "admin-menu-" + item.AdminMenuID;

            <li class="nav-item">

                @if (sMenu.Any())
                {
                    <a class="@(active ? "nav-link" : "nav-link collapsed")" data-bs-target="#@collapseId" data-bs-toggle="collapse" href="#@collapseId" aria-expanded="@(active ? "true" : "false")">
                        <i class="@item.Icon"></i>
                        <span>@item.ItemName</span>
                        <i class="bi bi-chevron-down ms-auto"></i>
                    </a>

                    <ul id="@collapseId" class="@(active ? "nav-content collapse show" : "nav-content collapse")" data-bs-parent="#sidebar-nav">

                        @foreach (var smn in sMenu)
                        {
                            <li>
                                <a asp-area="@MenuArea(smn)" asp-controller="@MenuController(smn.ControllerName)" asp-action="@(smn.ActionName ?? "Index")" asp-route-id="" class="@(IsCurrent(smn) ? "active" : null)">
                                    <i class="bi bi-circle"></i>
                                    <span>@smn.ItemName</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <a class="@(active ? "nav-link" : "nav-link collapsed")" asp-area="@MenuArea(item)" asp-controller="@MenuController(item.ControllerName)" asp-action="@(item.ActionName ?? "Index")" asp-route-id="">
                        <i class="@item.Icon"></i>
                        <span>@item.ItemName</span>
                    </a>
                }

            </li>
        }

    </ul>
</aside>
}
